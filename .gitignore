```gitignore
# Virtual environments
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Datasets and archives
data/
hairmony/
*.zip
*.z01
*.z02
*.z03
*.z04
*.z05
*.z06
*.z07
*.z08
*.z09
*.z10
images.z*

# Model files: keep only the model used by app.py
models/*
!models/hair_classifier_4class_best.keras
!models/hair_4class_names.json
!models/hair_4class_test_results.json

# Training outputs and temporary files
*.log
*.tmp
.DS_Store
Thumbs.db

# Streamlit secrets
.streamlit/secrets.toml
```